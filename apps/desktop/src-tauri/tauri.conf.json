{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Runtime",
  "version": "0.1.0",
  "identifier": "dev.localruntime.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Local Runtime",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480
      },
      {
        "label": "panel",
        "url": "index.html#panel",
        "title": "Local Runtime Panel",
        "width": 10,
        "height": 96,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/runtime-daemon",
      "binaries/runtime"
    ],
    "resources": {
      "../../../packages/runtime-mcp/dist": "mcp/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MuqiuPeng/PortManager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0MjRENzBBQkYzMDY2MjMKUldRalpqQy9DdGNrbE5QNjZZclFYbWErQTNSUnVFcUtKZ09IOHlZS2ZWKzdoU0JOZCthclJVdkQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
